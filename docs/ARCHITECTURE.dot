digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.18", nodesep="0.28", ranksep="0.5"];
  node [shape=box, style="rounded,filled", color="#577387", fillcolor="#eef4f7", fontname="DejaVu Sans", fontsize=11, margin="0.18,0.12"];
  edge [color="#4c7085", penwidth=1.4, arrowsize=0.7, fontname="DejaVu Sans", fontsize=10];

  subgraph cluster_ui {
    label="Input and interface"; color="#bfd3de"; style="rounded";
    input [label="Input
keyboard · mouse · touch"];
    ui [label="Menus / HUD / settings"];
  }

  subgraph cluster_control {
    label="Game loop"; color="#bfd3de"; style="rounded";
    state [label="Game state controller
intro, mode, score, waves"];
    loop [label="Frame loop
active play + idle render governor"];
  }

  subgraph cluster_gameplay {
    label="Gameplay systems"; color="#bfd3de"; style="rounded";
    player [label="Player movement and aiming"];
    combat [label="Weapons / combat resolution"];
    enemy [label="Enemy spawning + behaviour"];
    world [label="Arena, pickups, collisions"];
  }

  subgraph cluster_render {
    label="Rendering"; color="#bfd3de"; style="rounded";
    camera [label="Camera solving + follow logic"];
    render [label="WebGL renderer
adaptive resolution / quality"];
  }

  input -> state;
  ui -> state [label="options / mode"];
  state -> loop;
  loop -> player;
  loop -> enemy;
  player -> combat;
  enemy -> combat;
  world -> combat;
  player -> camera;
  enemy -> world;
  combat -> world;
  world -> camera;
  camera -> render;
  state -> ui [label="score / overlays"];
}
